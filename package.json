{
  "name": "w-hub",
  "version": "1.0.0",
  "description": "W-HUB 와이즈만·연세국제 선생님용 통합 사이트",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json",
    "check": "node tools/arch-check.mjs --self && node tools/arch-check.mjs",
    "check:server": "cd supabase/functions/api && deno check index.ts && deno lint",
    "test:server": "bash tests/local/db_reset.sh && cd tests/server && deno test -A api_test.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "verify": "bash tools/verify.sh"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "jose": "^6.2.18",
    "lit-html": "^3.3.3",
    "playwright": "^1.63.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module"
}
